---
import '../styles/global.css';
import { RUNTIME_ICON_NAMES, STATIC_ICON_NAMES } from '../web/shared/icons';
import { buildIconSprite } from '../lib/icon-sprite';
import { ENGINES } from '../config/search-engines';
import type { SiteRecord } from '../web/shared/search-utils';

const engineGlyphs = [...new Set(Object.values(ENGINES).flat().map((e) => e.icon))];
const iconSymbols = buildIconSprite([...RUNTIME_ICON_NAMES, ...STATIC_ICON_NAMES, ...engineGlyphs]);

interface Props {
  title?: string;
  description?: string;
  /** robots 指令；含 noindex（如 404）时省略 canonical / og / JSON-LD，避免错误页冒充首页 */
  robots?: string;
  searchIndex?: SiteRecord[];
  /** 是否首页；决定 body 的 page-home / page-inner，用于内容页顶栏融入背景 + 桌面隐藏侧栏 */
  isHome?: boolean;
}

const {
  title = '成医通 | 导航服务',
  description = '成都医学院学生维护的第三方导航站：为师生汇集校内门户、教务学籍、线上学习、医学文献检索、考试比赛、科研服务、AI 与实用工具等校园常用网站入口，一站直达。',
  robots = 'index, follow',
  searchIndex = [],
  isHome = false,
} = Astro.props;

function jsonForScript(value: unknown): string {
  return JSON.stringify(value).replace(/</g, '\\u003c');
}

const isNoindex = robots.includes('noindex');

const canonical = new URL(Astro.url.pathname, Astro.site);
const siteRoot = new URL('/', Astro.site);
const ogImage = new URL('/og.png', Astro.site).href;

const webSiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: '成医通',
  alternateName: '成医导航',
  url: siteRoot.href,
  description,
  inLanguage: 'zh-CN',
  potentialAction: {
    '@type': 'SearchAction',
    target: { '@type': 'EntryPoint', urlTemplate: `${siteRoot.href}?q={search_term_string}` },
    'query-input': 'required name=search_term_string',
  },
};
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#f2f4f7" />
    <link
      rel="preload"
      href="/fonts/DDjinbuti.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48 64x64" />
    <link rel="icon" type="image/svg+xml" href="/logo.svg" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    {!isNoindex && <link rel="canonical" href={canonical.href} />}

    {!isNoindex && (
      <>
        <!-- Open Graph -->
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:type" content="website" />
        <meta property="og:locale" content="zh_CN" />
        <meta property="og:url" content={canonical.href} />
        <meta property="og:site_name" content="成医通" />
        <meta property="og:image" content={ogImage} />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />

        <!-- Twitter Card -->
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:title" content={title} />
        <meta name="twitter:description" content={description} />
        <meta name="twitter:image" content={ogImage} />

        <script is:inline type="application/ld+json" set:html={jsonForScript(webSiteSchema)}></script>
      </>
    )}

    <script is:inline>
      (function () {
        var stored = null;
        try { stored = localStorage.getItem('theme'); } catch {}
        var dark =
          stored === 'dark' ||
          (stored === null && window.matchMedia('(prefers-color-scheme: dark)').matches);
        if (dark) document.documentElement.classList.add('dark');
        window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', function (e) {
          try {
            if (localStorage.getItem('theme') === null) {
              document.documentElement.classList.toggle('dark', e.matches);
            }
          } catch {}
        });
      })();
    </script>
  </head>
  <body id="top" class={isHome ? 'page-home' : 'page-inner'}>
    <script is:inline>
      // 顶栏滚过阈值后加深阴影；
      // 同时维护 body.is-scrolling：滚动中把右下悬浮球滑走，停手再滑回
      (function () {
        var ticking = false;
        var idleTimer = null;

        function sync() {
          document.body.classList.toggle('scrolled', window.scrollY > 8);
          ticking = false;
        }

        function onScroll() {
          if (!ticking) {
            ticking = true;
            requestAnimationFrame(sync);
          }
          document.body.classList.add('is-scrolling');
          clearTimeout(idleTimer);
          idleTimer = setTimeout(function () {
            document.body.classList.remove('is-scrolling');
          }, 260);
        }

        window.addEventListener('scroll', onScroll, { passive: true });
        sync();
      })();
    </script>
    <svg
      aria-hidden="true"
      style="position:absolute;width:0;height:0;overflow:hidden"
      set:html={iconSymbols}
    ></svg>
    <nav-dialog />
    <slot />

    {searchIndex.length > 0 && (
      <script is:inline type="application/json" id="site-index" set:html={jsonForScript(searchIndex)} />
    )}

    <script>
      import '../web/elements/nav-dialog';
    </script>
  </body>
</html>
