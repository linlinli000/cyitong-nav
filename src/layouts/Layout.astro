---
import '../styles/global.css';
import { RUNTIME_ICON_NAMES } from '../components/web/icons';
import { buildIconSprite } from '../lib/icon-sprite';
import { ENGINES } from '../data/search-engines';

const engineGlyphs = [...new Set(Object.values(ENGINES).flat().map((e) => e.icon))];
const iconSymbols = buildIconSprite([...RUNTIME_ICON_NAMES, ...engineGlyphs]);

interface Props {
  title?: string;
  description?: string;
  searchIndexJson?: string;
}

const {
  title = '成医通 | 导航服务',
  description = '成医学生维护的第三方导航：一站式汇集校内系统、医学文献、AI 工具与在线学习等校园常用网站，为师生提供直达入口。',
  searchIndexJson = '',
} = Astro.props;

const webSiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: '成医通',
  alternateName: '成医导航',
  url: 'https://nav.cyitong.top/',
  description,
  inLanguage: 'zh-CN',
};
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" type="image/svg+xml" href="/logo.svg" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta
      name="keywords"
      content="成都医学院,成医,成医通,导航,校内系统,医学文献,文献检索,AI工具,实用工具"
    />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href="https://nav.cyitong.top/" />

    <!-- Open Graph -->
    <meta property="og:title" content="成医通 | 导航服务" />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="zh_CN" />
    <meta property="og:url" content="https://nav.cyitong.top" />
    <meta property="og:site_name" content="成医通" />

    <script is:inline type="application/ld+json" set:html={JSON.stringify(webSiteSchema)}></script>

    <script is:inline>
      (function () {
        var stored = null;
        try { stored = localStorage.getItem('theme'); } catch (e) {}
        var dark =
          stored === 'dark' ||
          (stored === null && window.matchMedia('(prefers-color-scheme: dark)').matches);
        if (dark) document.documentElement.classList.add('dark');
        window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', function (e) {
          try {
            if (localStorage.getItem('theme') === null) {
              document.documentElement.classList.toggle('dark', e.matches);
            }
          } catch (ex) {}
        });
      })();
    </script>
  </head>
  <body>
    <svg
      aria-hidden="true"
      style="position:absolute;width:0;height:0;overflow:hidden"
      set:html={iconSymbols}
    ></svg>
    <nav-dialog />
    <slot />

    {searchIndexJson && (
      <script is:inline type="application/json" id="site-index" set:html={searchIndexJson} />
    )}

    <script>
      import '../components/web/nav-dialog';
    </script>
  </body>
</html>
