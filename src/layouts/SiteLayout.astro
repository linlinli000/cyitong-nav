---
import type { CollectionEntry } from 'astro:content';
import type { SiteRecord } from '../web/shared/search-utils';
import Layout from './Layout.astro';
import Sidebar from '../components/Sidebar.astro';
import TopBar from '../components/TopBar.astro';
import Footer from '../components/Footer.astro';
import BackToTop from '../components/BackToTop.astro';
import ThemeToggle from '../components/ThemeToggle.astro';

interface Props {
  categories: CollectionEntry<'sites'>[];
  totalLinks: number;
  isHome: boolean;
  title?: string;
  description?: string;
  robots?: string;
  /** 只有首页有搜索 UI；不传即不输出 #site-index */
  searchIndex?: SiteRecord[];
}

const { categories, totalLinks, isHome, title, description, robots, searchIndex } = Astro.props;
---

<Layout title={title} description={description} robots={robots} searchIndex={searchIndex} isHome={isHome}>
  <!-- 顶栏：全宽 fixed 毛玻璃药丸，覆盖在 hero 之上 -->
  <TopBar isHome={isHome} />

  <!-- 首页 hero 全宽通栏；内容页不传 hero slot 时整块不渲染 -->
  {Astro.slots.has('hero') && (
    <div class="hero-wrap">
      <slot name="hero" />
    </div>
  )}

  <!-- 侧栏与内容区在同一栅格里：让位、折叠、sticky 全由 theme.css 的 --rail-w 维护 -->
  <div class="page-shell">
    <nav-sidebar>
      <Sidebar categories={categories} isHome={isHome} />
    </nav-sidebar>

    <div class="site-content">
      <slot />
      <Footer totalLinks={totalLinks} />
    </div>
  </div>

  <BackToTop />
  <ThemeToggle />
</Layout>

<script>
  import '../web/elements/nav-sidebar';
</script>
