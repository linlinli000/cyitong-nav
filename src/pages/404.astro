---
import { getSiteData } from '../lib/site-data';
import SiteLayout from '../layouts/SiteLayout.astro';

const { categories, totalLinks } = await getSiteData();
---

<SiteLayout
  title="页面未找到 - 成医通"
  description="你访问的页面不存在或已被移动。"
  robots="noindex, follow"
  isHome={false}
  categories={categories}
  totalLinks={totalLinks}
>
  <main class="flex min-h-[70vh] items-center justify-center px-6 py-16">
    <div class="text-center">
      <p class="text-7xl font-bold text-brand/20">404</p>
      <h1 class="mt-4 text-xl font-semibold text-ink">页面走丢了</h1>
      <p class="mt-2 text-sm text-muted">你访问的页面不存在，或已被移动。</p>
      <a
        href="/"
        class="btn-brand mt-8 inline-block rounded-xl px-6 py-2.5 text-sm font-medium"
      >
        返回首页
      </a>
    </div>
  </main>
</SiteLayout>
