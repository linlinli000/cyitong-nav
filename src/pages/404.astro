---
import Layout from '../layouts/Layout.astro';
---

<Layout title="页面未找到 - 成医通">
  <div class="flex min-h-screen items-center justify-center px-6">
    <div class="text-center">
      <p class="text-7xl font-bold text-brand/20">404</p>
      <h1 class="mt-4 text-xl font-semibold text-ink">页面走丢了</h1>
      <p class="mt-2 text-sm text-muted">你访问的页面不存在，或已被移动。</p>
      <a
        href="/"
        class="mt-8 inline-block rounded-xl bg-brand px-6 py-2.5 text-sm font-medium text-white transition-colors hover:bg-brand-dark"
      >
        返回首页
      </a>
    </div>
  </div>
</Layout>
