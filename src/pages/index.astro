---
import { getSiteData } from '../lib/site-data';
import SiteLayout from '../layouts/SiteLayout.astro';
import SearchPanel from '../components/SearchPanel.astro';
import CategoryBlock from '../components/CategoryBlock.astro';

const { categories, searchIndex, totalLinks } = await getSiteData();
---

<SiteLayout
  categories={categories}
  totalLinks={totalLinks}
  searchIndex={searchIndex}
  isHome={true}
>
  <main class="px-3 py-6 sm:px-4">
    <h1 class="sr-only">成医通：成都医学院师生第三方导航</h1>
    <SearchPanel total={totalLinks} />

    <div class="mt-6 space-y-6 sm:mt-10" data-nosnippet>
      {categories.map((cat) => <CategoryBlock category={cat} />)}
    </div>
  </main>
</SiteLayout>

<script>
  import { registerLetterFallback } from '../web/img-fallback';
  import '../web/link-tip';
  registerLetterFallback();
</script>
