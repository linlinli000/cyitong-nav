---
import { Icon } from 'astro-icon/components';
import { getSiteData } from '../lib/site-data';
import SiteLayout from '../layouts/SiteLayout.astro';

const { categories, totalLinks } = await getSiteData();

interface Fact {
  icon: string;
  label: string;
  text: string;
}

interface Use {
  icon: string;
  title: string;
  text: string;
}

const USES: Use[] = [
  {
    icon: 'lucide:search',
    title: '搜索',
    text: '按 / 聚焦搜索框，支持全拼与首字母（xxw 即可命中「学信网」）；范围中的「文献检索」可直达 PubMed、知网、万方。',
  },
  {
    icon: 'lucide:git-branch',
    title: '卡片标记',
    text: '同一站点有多个地址时（如安娜的档案、Z-Library），点击卡片弹出入口列表；「镜像」为备用地址，主站不可用时改用。',
  },
  {
    icon: 'lucide:panel-left',
    title: '侧栏',
    text: '桌面端可将侧栏收为图标栏，收起后悬停仍显示子分类；移动端为左上角抽屉。',
  },
];

interface Browser {
  icon: string;
  name: string;
  steps: string[];
}

const BROWSERS: Browser[] = [
  {
    icon: 'simple-icons:googlechrome',
    name: 'Google Chrome 设为首页',
    steps: [
      '复制本站地址：https://nav.cyitong.top',
      '点击右上角菜单，选择「设置」。',
      '找到「启动时」，选择「打开特定网页或一组网页」。',
      '点击「添加新网页」，粘贴刚复制的地址，点击「添加」保存。',
    ],
  },
  {
    icon: 'simple-icons:microsoftedge',
    name: 'Microsoft Edge 设为首页',
    steps: [
      '复制本站地址：https://nav.cyitong.top',
      '点击右上角菜单，选择「设置」。',
      '在「启动时」中选择「打开一个或多个特定页面」，点击「添加新页面」，粘贴刚复制的地址并保存。',
      '如需在工具栏显示首页按钮：在「启动时」下方的「开始按钮」中勾选在工具栏显示，并粘贴同一地址后保存。',
    ],
  },
];

const PRIVACY_FACTS: Fact[] = [
  {
    icon: 'lucide:clock',
    label: '更新节奏',
    text: '更新与纠错由维护者课余时间处理，无法保证即时响应。',
  },
  {
    icon: 'lucide:database',
    label: '数据与托管',
    text: '链接数据只有一份，即仓库中各分类的 YAML 文件；构建生成静态页面，无后端、无数据库、无账号。',
  },
  {
    icon: 'lucide:shield-check',
    label: '隐私',
    text: '不接入第三方统计，访问不会被记录；主题、侧栏折叠、搜索范围与历史仅存于浏览器本地。',
  },
  {
    icon: 'lucide:lock',
    label: '账号安全',
    text: '校方系统的账号与密码只在学校域名（cmc.edu.cn）或校内网页面填写；本站不收集，也无法读取。',
  },
];

const DISCLAIMER_FACTS: Fact[] = [
  {
    icon: 'lucide:scale',
    label: '收录与利益',
    text: '收录不收取任何费用，无广告位与推广位，收录与排序不含利益关系。',
  },
  {
    icon: 'lucide:external-link',
    label: '第三方内容',
    text: '链接均指向第三方站点，内容与可用性由对方负责；收录不代表推荐。',
  },
  {
    icon: 'lucide:flag',
    label: '侵权处理',
    text: '如有内容侵犯权益或不宜收录，可通过下方任一渠道告知，核实后移除。',
  },
];

interface Contact {
  icon: string;
  label: string;
  value: string;
  href: string;
  external?: boolean;
}

const CONTACTS: Contact[] = [
  { icon: 'lucide:file-plus', label: '投稿与纠错', value: '投稿与反馈', href: '/contribute/' },
  {
    icon: 'lucide:mail',
    label: '邮箱',
    value: 'linlinli_000@163.com',
    href: 'mailto:linlinli_000@163.com',
  },
];

type FaqPart = string | { text: string; href: string };

interface Faq {
  icon: string;
  q: string;
  a: string | FaqPart[];
  points?: string[];
  note?: string;
}

// 答复里的链接写在句子中间，故按片段顺序渲染
const parts = (a: Faq['a']): FaqPart[] => (typeof a === 'string' ? [a] : a);

const FAQS: Faq[] = [
  {
    icon: 'lucide:search',
    q: '搜不到某个站点怎么办？',
    a: [
      '站内搜索匹配的是本站已收录条目的名称、分类与简介，不含站点内部的页面内容。若站内确实没有，可前往',
      { text: '投稿与反馈', href: '/contribute/' },
      '页面提交。',
    ],
  },
  {
    icon: 'lucide:link',
    q: '链接打不开怎么办？',
    a: '按下面三类依次排查，多数情况能自行判断。',
    points: [
      '海外站点（ChatGPT、Google Scholar、Z-Library 等）：需要国际网络出口，打不开与条目本身是否有效无关；换镜像也没用，镜像同样在海外。',
      '仅校内网可达的系统（一卡通、校园网认证）：在校外通常打不开，连上校园网即可。',
      '站点临时维护或更换域名：带「镜像」徽章的条目可先改用备用地址。',
    ],
    note: '长期失效请反馈，核实后会更正或移除。',
  },
  {
    icon: 'lucide:smartphone',
    q: '有 App 或小程序吗？',
    a: '没有。本站只有网页版，手机浏览器可直接使用，也可通过浏览器的「添加到主屏幕」建为桌面图标。',
  },
];
---

<SiteLayout
  title="关于本站 - 成医通"
  description="成医通（nav.cyitong.top）是成都医学院学生维护的第三方非官方导航站。本页说明站点用法与常见问题、维护与隐私、免责声明与联系方式。"
  isHome={false}
  categories={categories}
  totalLinks={totalLinks}
>
  <main class="px-3 py-6 sm:px-4">
    <article class="doc-page">
      <header class="doc-hero">
        <h1>关于本站</h1>
        <p class="doc-lead">
          成医通由学生维护，属第三方非官方站点，与成都医学院无隶属关系。本站收录成医师生常用的站点，按分类整理于一页，免去逐个收藏与翻找。
        </p>
      </header>

      <h2 id="usage">使用说明</h2>
      <div class="my-4 grid gap-3">
        {
          USES.map((use) => (
            <div class="doc-card">
              <div class="doc-card-head">
                <span class="doc-icon">
                  <Icon name={use.icon} class="h-5 w-5" aria-hidden="true" />
                </span>
                <h3>{use.title}</h3>
              </div>
              <p class="mt-2 text-body text-muted">{use.text}</p>
            </div>
          ))
        }
      </div>

      <h2 id="tutorial">首页设置</h2>
      <p>
        将本站设为浏览器主页或加入收藏，可免去每次输入网址。按 Ctrl+D（macOS 为 Command+D）可收藏本页，也可将页面中的站点 logo 拖入收藏夹。
      </p>
      <div class="my-4 grid gap-3">
        {
          BROWSERS.map((browser) => (
            <div class="doc-card">
              <div class="doc-card-head">
                <span class="doc-icon">
                  <Icon name={browser.icon} class="h-5 w-5" aria-hidden="true" />
                </span>
                <h3>{browser.name}</h3>
              </div>
              <ol class="doc-steps">
                {browser.steps.map((step) => (
                  <li>{step}</li>
                ))}
              </ol>
            </div>
          ))
        }
      </div>

      <h2 id="faq">常见问题</h2>
      <div class="doc-faq">
        {
          FAQS.map((item) => (
            <details>
              <summary>
                <span class="inline-flex items-center gap-2">
                  <Icon name={item.icon} class="h-4 w-4 shrink-0 text-brand" aria-hidden="true" />
                  {item.q}
                </span>
                <Icon
                  name="lucide:chevron-down"
                  class="doc-faq-chevron h-4 w-4 shrink-0 text-muted"
                  aria-hidden="true"
                />
              </summary>
              <p class="text-muted">
                {
                  parts(item.a).map((part) =>
                    typeof part === 'string' ? part : <a href={part.href}>{part.text}</a>
                  )
                }
              </p>
              {item.points && (
                <ol class="doc-steps text-muted">
                  {item.points.map((point) => (
                    <li>{point}</li>
                  ))}
                </ol>
              )}
              {item.note && <p class="text-muted">{item.note}</p>}
            </details>
          ))
        }
      </div>

      <h2 id="notes">维护与隐私</h2>
      <div class="doc-facts">
        {
          PRIVACY_FACTS.map((fact) => (
            <p>
              <span class="doc-fact-icon">
                <Icon name={fact.icon} class="h-4 w-4" aria-hidden="true" />
              </span>
              <strong>{fact.label}</strong>
              {fact.text}
            </p>
          ))
        }
      </div>

      <h2 id="disclaimer">免责声明</h2>
      <div class="doc-facts">
        {
          DISCLAIMER_FACTS.map((fact) => (
            <p>
              <span class="doc-fact-icon">
                <Icon name={fact.icon} class="h-4 w-4" aria-hidden="true" />
              </span>
              <strong>{fact.label}</strong>
              {fact.text}
            </p>
          ))
        }
      </div>

      <h2 id="contact">联系方式</h2>
      <p>投稿、链接纠错与侵权反馈均可通过以下渠道提交。</p>
      <div class="doc-rows my-4">
        {
          CONTACTS.map((c) => (
            <a
              href={c.href}
              class="doc-row"
              target={c.external ? '_blank' : undefined}
              rel={c.external ? 'noopener noreferrer' : undefined}
            >
              <Icon name={c.icon} class="h-4 w-4 shrink-0 text-brand" aria-hidden="true" />
              <span class="doc-row-label">{c.label}</span>
              <span class="doc-row-value">{c.value}</span>
            </a>
          ))
        }
      </div>
    </article>
  </main>
</SiteLayout>
