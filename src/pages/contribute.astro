---
import { Icon } from 'astro-icon/components';
import { getSiteData } from '../lib/site-data';
import SiteLayout from '../layouts/SiteLayout.astro';

const { categories, totalLinks } = await getSiteData();

// 本页只列收录条件，全站收录标准与准入原则亦见 /about
const RULES = [
  '优先收录公网可直达的站点；仅校内网可达的系统（如一卡通、校园网认证）同样收录。',
  '站点运行稳定，无恶意弹窗、强制下载等行为。',
  '同一用途已有更通用的入口时不重复收录；官方备用地址除外，标注「镜像」徽章。',
  '需登录或有明显使用门槛的，在条目简介中注明。',
];

const MAIL = 'linlinli_000@163.com';
const ISSUE_URL = 'https://github.com/linlinli000/cyitong-nav/issues/new';
const REPO_URL = 'https://github.com/linlinli000/cyitong-nav';

// 与卡片展示模板同源，点击时各行已填好
const MAIL_FIELDS = [
  '反馈类型：投稿 / 链接失效 / 不宜收录',
  '网站名称：',
  '网址：',
  '建议分类（投稿填）：',
  '用途或问题说明：',
];
const MAILTO = `mailto:${MAIL}?subject=${encodeURIComponent('成医通反馈')}&body=${encodeURIComponent(MAIL_FIELDS.join('\n'))}`;
---

<SiteLayout
  title="投稿与反馈 - 成医通"
  description="向成医通提交反馈的说明：纠正失效链接、反馈不宜收录的内容、补充新站点都可从本页提交，附发邮件、提 Issue 与提交 Pull Request 三种渠道、可复制的邮件模板，以及收录条件。"
  isHome={false}
  categories={categories}
  totalLinks={totalLinks}
>
  <main class="px-3 py-6 sm:px-4">
    <article class="doc-page">
      <header class="doc-hero">
        <h1>投稿与反馈</h1>
        <p class="doc-lead">
          若链接失效或已更换域名、某条不宜收录、想补充站点，都可以从本页提交。
        </p>
      </header>

      <h2 id="criteria">收录条件</h2>
      <div class="doc-card my-4">
        <ol class="doc-steps">
          {RULES.map((rule) => <li>{rule}</li>)}
        </ol>
      </div>

      <h2 id="submit">提交方式</h2>
      <p>以下方式任选其一。</p>
      <div class="my-4 grid gap-3">
        <div class="doc-card">
          <div class="doc-card-head">
            <span class="doc-icon">
              <Icon name="lucide:mail" class="h-5 w-5" aria-hidden="true" />
            </span>
            <h3>发送邮件</h3>
          </div>
          <p class="mt-2 text-dense text-muted">
            不需要注册任何账号，点按钮会自动带上下面的模板，按实际情况填写后发送即可。
          </p>
          <pre><code>{MAIL_FIELDS.join('\n')}</code></pre>
          <p class="text-dense text-muted">
            分类拿不准可留空，或参照<a href="/">首页</a>的分类；其余未定项由维护者补全。
          </p>
          <p class="mt-3">
            <a
              href={MAILTO}
              class="btn-brand inline-flex items-center gap-2 rounded-xl px-6 py-2.5 text-sm font-medium no-underline"
            >
              <Icon name="lucide:send" class="h-4 w-4" aria-hidden="true" />
              写邮件
            </a>
          </p>
        </div>

        <div class="doc-card">
          <div class="doc-card-head">
            <span class="doc-icon">
              <svg class="h-5 w-5" aria-hidden="true"><use href="#icon-github"/></svg>
            </span>
            <h3>提交 Issue</h3>
          </div>
          <p class="mt-2 text-dense text-muted">
            有 GitHub 账号且能正常访问 GitHub 时更合适：可以直接附截图，进度也能在 Issue 里追踪。
          </p>
          <p class="mt-3">
            <a
              href={ISSUE_URL}
              target="_blank"
              rel="noopener noreferrer"
              class="btn-brand inline-flex items-center gap-2 rounded-xl px-6 py-2.5 text-sm font-medium no-underline"
            >
              <Icon name="lucide:external-link" class="h-4 w-4" aria-hidden="true" />
              新建 Issue
            </a>
          </p>
        </div>

        <div class="doc-card">
          <div class="doc-card-head">
            <span class="doc-icon">
              <Icon name="lucide:git-pull-request" class="h-5 w-5" aria-hidden="true" />
            </span>
            <h3>提交 Pull Request</h3>
          </div>
          <p class="mt-2 text-dense text-muted">
            全站数据与代码托管于 <a href={REPO_URL} target="_blank" rel="noopener noreferrer">GitHub</a
            >，会改 YAML 就能参与；字段含义、多入口与徽章等完整写法见仓库 <a
              href={`${REPO_URL}#readme`}
              target="_blank"
              rel="noopener noreferrer">README</a
            >。
          </p>
          <ol class="doc-steps">
            <li>
              <strong>加数据、放图标</strong>：在 <code>src/content/sites/{'{分类id}'}.yaml</code> 的 <code
                >subs[].links[]</code
              > 追加记录；图标存为 <code>public/icons/{'{分类id}'}/{'{链接id}'}.webp</code>，文件名与记录的
              <code>id</code> 一致。
            </li>
            <li>
              <strong>本地校验</strong>：执行 <code>npm run build</code>，构建期会拦下图标缺失、id
              重复、搜索字段缺失、url 缺少协议头等问题，并指出对应链接。
            </li>
            <li><strong>发 Pull Request</strong>：构建通过后提交，维护者确认后合并上线。</li>
          </ol>
        </div>
      </div>
    </article>
  </main>
</SiteLayout>
