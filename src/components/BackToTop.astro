---
import { Icon } from 'astro-icon/components';
---

<!-- z-20 低于移动抽屉雾隐(z-30)，抽屉打开时被遮盖 -->
<nav-backtotop>
  <button
    type="button"
    data-role="btn"
    aria-label="回到顶部"
    class="nav-fab pointer-events-none bottom-8 translate-y-2 opacity-0 hover:-translate-y-0.5 hover:shadow-[var(--shadow-menu)] active:scale-95"
  >
    <Icon name="lucide:chevron-up" class="h-5 w-5" aria-hidden="true" />
  </button>
</nav-backtotop>

<script>
  import '../web/elements/nav-backtotop';
</script>
