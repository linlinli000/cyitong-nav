---
import type { CollectionEntry } from 'astro:content';
import { Icon } from 'astro-icon/components';
import { categoryIcon } from '../config/category-icons';
import LinkCard from './LinkCard.astro';

interface Props {
  category: CollectionEntry<'sites'>;
}

const { category } = Astro.props;
---

<section id={category.data.id} data-spy data-cat-block={category.data.id} class="content-card">
  <div class="cat-head">
    <h2 class="cat-title">
      <span class="cat-glyph">
        <Icon name={categoryIcon(category.data.icon)} aria-hidden="true" />
      </span>
      {category.data.name}
    </h2>

    <nav-cat-tabs class="cat-tabs min-w-0">
      <div data-fade-x class="scrollbar-hide overflow-x-auto">
        <div role="tablist" aria-label={`${category.data.name}的子分类筛选`}>
          <button
            type="button"
            id={`cat-tab-${category.data.id}-all`}
            class="cat-tab active"
            role="tab"
            aria-selected="true"
            aria-controls={`cat-panel-${category.data.id}`}
            data-filter=""
          >
            全部
          </button>
          {
            category.data.subs.map((sub) => (
              <button
                type="button"
                id={`cat-tab-${category.data.id}-${sub.id}`}
                class="cat-tab"
                role="tab"
                aria-selected="false"
                aria-controls={`cat-panel-${category.data.id}`}
                tabindex="-1"
                data-filter={sub.id}
              >
                {sub.name}
              </button>
            ))
          }
        </div>
      </div>
    </nav-cat-tabs>

    <span class="cat-more-line" aria-hidden="true"></span>

    <button
      type="button"
      class="cat-more"
      aria-expanded="false"
      aria-controls={`cat-panel-${category.data.id}`}
      hidden
    >
      <span class="cat-more-label">更多</span>
      <Icon name="lucide:chevron-down" class="cat-more-chevron" aria-hidden="true" />
    </button>
  </div>

  <div
    id={`cat-panel-${category.data.id}`}
    role="tabpanel"
    aria-labelledby={`cat-tab-${category.data.id}-all`}
    class="cat-grid"
  >
    {
      category.data.subs.flatMap((sub) =>
        sub.links.map((link) => (
          <LinkCard link={link} categoryId={category.data.id} sub={sub.id} />
        )),
      )
    }
  </div>
</section>

<script>
  import '../web/elements/nav-cat-tabs';
</script>
