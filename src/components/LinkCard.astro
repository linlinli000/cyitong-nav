---
import type { Link } from '../content.config';
import { Icon } from 'astro-icon/components';
import { toCardData, toDataAttrs } from '../web/card-attrs';
import { iconPath } from '../web/icon-path';
import { firstLetter } from '../web/first-letter';

interface Props {
  categoryId: string;
  sub: string;
  link: Link;
}

const { categoryId, sub, link } = Astro.props;
const card = toCardData({
  title: link.title,
  url: link.url,
  icon: iconPath(categoryId, link.id),
  qr: link.qr,
  qrNote: link.qrNote,
  entries: link.entries,
});
const cardAttrs = toDataAttrs(card);
const fallback = firstLetter(link.title);
---

<a
  href={link.url}
  target="_blank"
  rel="noopener noreferrer"
  data-sub={sub}
  data-desc={link.desc ? link.desc : undefined}
  {...cardAttrs}
  class="link-tile group relative flex items-center gap-3 rounded-card bg-card p-3"
>
  <span class="relative block h-10 w-10 shrink-0">
    <span
      class="icon-glow"
      aria-hidden="true"
      style={`background-image: url('${iconPath(categoryId, link.id)}')`}
    />
    <img
      src={iconPath(categoryId, link.id)}
      alt={link.title}
      width="40"
      height="40"
      loading="lazy"
      decoding="async"
      data-letter={fallback}
      class="link-tile-icon relative h-10 w-10 rounded-xl object-cover"
    />
  </span>
  <span class="min-w-0 flex-1">
    <span class="flex min-w-0 items-center gap-1">
      <span class="truncate text-sm font-semibold text-ink transition-colors group-hover:text-brand">
        {link.title}
      </span>
      {link.badge && <span class="shrink-0 rounded bg-brand/10 px-1 py-0.5 text-chip font-medium leading-none text-brand">{link.badge}</span>}
    </span>
    {link.desc && <span class="mt-0.5 block truncate text-note text-muted">{link.desc}</span>}
  </span>
  <Icon
    name="lucide:arrow-up-right"
    aria-hidden="true"
    class="pointer-events-none absolute top-1.5 right-1.5 h-4 w-4 -translate-x-1 translate-y-1 text-muted opacity-0 transition-all duration-200 group-hover:translate-x-0 group-hover:translate-y-0 group-hover:opacity-100"
  />
</a>
