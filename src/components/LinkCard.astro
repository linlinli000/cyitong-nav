---
import type { Link } from '../content.config';
import { Icon } from 'astro-icon/components';
import { toCardData, toDataAttrs } from '../web/shared/card-attrs';
import { iconPath } from '../web/shared/icon-path';
import { siteIconHtml } from '../web/shared/site-icon';

interface Props {
  categoryId: string;
  sub: string;
  link: Link;
}

const { categoryId, sub, link } = Astro.props;
const card = toCardData({
  title: link.title,
  url: link.url,
  icon: iconPath(categoryId, link.id),
  qr: link.qr,
  qrNote: link.qrNote,
  entries: link.entries,
});
const cardAttrs = toDataAttrs(card);
---

<a
  href={link.url}
  target="_blank"
  rel="noopener noreferrer"
  data-sub={sub}
  data-desc={link.desc ? link.desc : undefined}
  {...cardAttrs}
  class="link-tile"
>
  <span class="tile-icon-wrap">
    <span
      class="icon-glow"
      aria-hidden="true"
      style={`background-image: url('${iconPath(categoryId, link.id)}')`}
    ></span>
    <Fragment
      set:html={siteIconHtml(iconPath(categoryId, link.id), link.title, 'tile-icon', { size: 40 })}
    />
  </span>
  <span class="tile-body">
    <span class="tile-title">{link.title}</span>
    {
      (link.desc || link.badge) && (
        <span class="tile-desc-row">
          {link.badge && <span class="tile-badge">{link.badge}</span>}
          {link.desc && <span class="tile-desc">{link.desc}</span>}
        </span>
      )
    }
  </span>
  <Icon name="lucide:arrow-up-right" class="tile-arrow" aria-hidden="true" />
</a>
