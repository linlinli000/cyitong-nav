---
import type { Mirror } from '../content.config';
import { toCardData, toDataAttrs } from '../web/card-attrs';
import { firstLetter } from '../web/img-fallback';

interface Props {
  categoryId: string;
  sub: string;
  link: {
    id: string;
    title: string;
    desc?: string;
    url: string;
    qr?: boolean;
    qrNote?: string;
    mirrors?: Mirror[];
  };
}

const { categoryId, sub, link } = Astro.props;
const card = toCardData({
  title: link.title,
  url: link.url,
  icon: `/icons/${categoryId}/${link.id}.webp`,
  qr: link.qr,
  qrNote: link.qrNote,
  mirrors: link.mirrors,
});
const cardAttrs = toDataAttrs(card);
const fallback = firstLetter(link.title);
---

<a
  href={link.url}
  target="_blank"
  rel="noopener noreferrer"
  data-sub={sub}
  data-desc={link.desc ? link.desc : undefined}
  {...cardAttrs}
  class="link-tile group relative flex items-center gap-3 rounded-2xl border border-line bg-card p-3 dark:border-line/60"
>
  <img
    src={`/icons/${categoryId}/${link.id}.webp`}
    alt=""
    width="40"
    height="40"
    loading="lazy"
    decoding="async"
    data-letter={fallback}
    class="link-tile-icon h-10 w-10 shrink-0 rounded-xl border border-line object-cover"
  />
  <span class="min-w-0 flex-1">
    <span class="flex min-w-0 items-center gap-1">
      <span class="truncate text-sm font-semibold text-ink transition-colors group-hover:text-brand">
        {link.title}
      </span>
      {card.mirrors && <span class="shrink-0 rounded bg-brand/10 px-1 py-0.5 text-[10px] font-medium leading-none text-brand">镜像</span>}
      {card.qr && <span class="shrink-0 rounded bg-brand/10 px-1 py-0.5 text-[10px] font-medium leading-none text-brand">扫码</span>}
    </span>
    {link.desc && <span class="mt-0.5 block truncate text-xs text-muted">{link.desc}</span>}
  </span>
</a>
