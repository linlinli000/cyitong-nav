---
import { Icon } from 'astro-icon/components';
import { TOOLS } from '../config/topbar-tools';
import { SITE_LINKS, brandHref } from '../config/site-links';
import ToolIcon from './ToolIcon.astro';

interface Props {
  isHome: boolean;
}

const { isHome } = Astro.props;

/** 顶栏主导航：与站内页面一一对应 */
const NAV = [
  { label: '首页', href: '/', icon: 'lucide:home', current: isHome },
  { label: '投稿与反馈', href: '/contribute/', icon: 'lucide:edit-3', current: false },
  { label: '关于本站', href: '/about/', icon: 'lucide:info', current: false },
];

/** 右侧快捷项：只用带下拉的三组工具（翻译 / 网盘 / 邮箱），不再放站内锚点文字链 */
const QUICK = TOOLS;
---

<header class="topbar">
  <div class="topbar-pill">
    <nav class="topbar-inner" aria-label="站点导航">
      <button
        type="button"
        data-mobile-nav-open
        aria-label="打开菜单"
        aria-expanded="false"
        class="topbar-icon topbar-icon--mobile menu-btn"
      >
        <span class="menu-bar" aria-hidden="true"></span>
        <span class="menu-bar" aria-hidden="true"></span>
        <span class="menu-bar" aria-hidden="true"></span>
      </button>

      <a href={brandHref(isHome)} class="topbar-brand" aria-label="成医通">
        <img src="/logo.svg" alt="成医通" width="36" height="36" />
        <span class="topbar-brand-text">
          <b>成医通</b>
          <small>nav.cyitong.top</small>
        </span>
      </a>

      <ul class="topbar-menu">
        {
          NAV.map((item) => (
            <li class={item.current ? 'is-current' : ''}>
              <a href={item.href} aria-current={item.current ? 'page' : undefined}>
                <Icon name={item.icon} class="mr-1.5 inline h-4 w-4 align-[-2px]" aria-hidden="true" />
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>

      <span class="topbar-spacer" aria-hidden="true"></span>

      <ul class="topbar-quick">
        {
          QUICK.map((tool) => (
            <li class="relative" data-menu="">
              <button
                type="button"
                data-menu-btn
                aria-haspopup="true"
                aria-expanded="false"
                title={tool.label}
              >
                <Icon name={tool.icon} class="h-4 w-4 shrink-0" aria-hidden="true" />
                {tool.label}
                <Icon
                  name="lucide:chevron-down"
                  class="h-3 w-3 shrink-0 opacity-70"
                  aria-hidden="true"
                />
              </button>
              <div data-menu-panel class="absolute right-0 top-full z-50 mt-1 min-w-36">
                {tool.items.map((sub) => (
                  <a
                    href={sub.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    data-menu-item
                    class="flex items-center gap-2"
                  >
                    <ToolIcon icon={sub.icon} />
                    <span class="truncate">{sub.name}</span>
                  </a>
                ))}
              </div>
            </li>
          ))
        }
      </ul>

      <div class="topbar-icons">
        <a
          href="https://wiki.cyitong.top"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="wiki"
          title="wiki"
          class="topbar-icon topbar-icon--sm"
        >
          <Icon name="lucide:book-open" aria-hidden="true" />
        </a>
        <a
          href="https://github.com/linlinli000/cyitong-nav"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="GitHub 源码"
          title="GitHub 源码"
          class="topbar-icon topbar-icon--md"
        >
          <svg class="h-5 w-5" aria-hidden="true"><use href="#icon-github" /></svg>
        </a>
        <button
          type="button"
          data-role="tools-open"
          aria-label="打开工具箱"
          aria-haspopup="dialog"
          aria-expanded="false"
          class="topbar-icon topbar-icon--mobile tools-btn"
        >
          <span class="tools-icon tools-icon--grid" aria-hidden="true">
            <Icon name="lucide:layout-grid" />
          </span>
          <span class="tools-icon tools-icon--close" aria-hidden="true">
            <Icon name="lucide:x" />
          </span>
        </button>
      </div>
    </nav>
  </div>
</header>

<!-- 移动端工具箱抽屉（翻译/网盘/邮箱全量 + 底部站内链接） -->
<nav-tools>
  <dialog
    data-role="tools-dlg"
    tabindex="-1"
    class="m-0 ml-auto h-dvh max-h-dvh w-56 max-w-[84vw] bg-float backdrop-blur-md p-0 text-ink shadow-(--shadow-menu) focus:outline-none backdrop:bg-black/40"
  >
    <div class="flex h-full flex-col">
      <div class="flex h-14 shrink-0 items-center px-4">
        <span class="flex items-center gap-2 text-lg font-bold">
          <Icon name="lucide:layout-grid" class="h-5 w-5 text-brand" aria-hidden="true" />
          工具箱
        </span>
      </div>
      <div class="scrollbar-hide flex-1 space-y-0.5 overflow-y-auto px-2 pb-4 pt-1">
        {
          TOOLS.map((tool) => (
            <section>
              <h3 class="mb-1.5 flex items-center gap-x-2 rounded-lg py-3 pl-3.5 pr-2 text-body font-medium text-muted">
                <Icon name={tool.icon} class="h-[21px] w-[21px] shrink-0" aria-hidden="true" />
                {tool.label}
                <span class="ml-auto shrink-0 text-note text-muted">{tool.items.length}</span>
              </h3>
              <div class="grid grid-cols-2 gap-1.5">
                {tool.items.map((item) => (
                  <a
                    href={item.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="flex h-[72px] flex-col items-center justify-center gap-1.5 rounded-xl bg-surface px-2 text-dense text-muted transition-colors hover:bg-track hover:text-ink"
                  >
                    <img
                      src={item.icon}
                      alt=""
                      aria-hidden="true"
                      loading="lazy"
                      class="h-6 w-6 shrink-0 rounded-md object-contain"
                    />
                    <span class="max-w-full min-w-0 truncate text-center">{item.name}</span>
                  </a>
                ))}
              </div>
            </section>
          ))
        }
      </div>
      <div class="shrink-0 space-y-0.5 px-2 py-4">
        {
          SITE_LINKS.map((l) => (
            <a
              href={l.href}
              class="flex w-full items-center gap-x-2 rounded-lg py-3 pl-3.5 pr-2 font-medium text-muted transition-colors hover:bg-tint hover:text-ink"
            >
              <Icon name={l.icon} class="h-[21px] w-[21px] shrink-0 text-brand" aria-hidden="true" />
              <span class="min-w-0 truncate text-body">{l.label}</span>
            </a>
          ))
        }
      </div>
    </div>
  </dialog>
</nav-tools>

<script>
  import '../web/header-dropdown';
  import '../web/elements/nav-tools';
</script>
