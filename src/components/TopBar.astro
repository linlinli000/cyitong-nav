---
import { Icon } from 'astro-icon/components';
import { TOOLS } from '../config/topbar-tools';
import { SITE_LINKS, brandHref } from '../config/site-links';
import ToolIcon from './ToolIcon.astro';

interface Props {
  isHome: boolean;
}

const { isHome } = Astro.props;

/** 顶栏主导航：与站内页面一一对应 */
const NAV = [
  { label: '首页', href: '/', icon: 'lucide:home', current: isHome },
  { label: '投稿与反馈', href: '/contribute/', icon: 'lucide:edit-3', current: false },
  { label: '关于本站', href: '/about/', icon: 'lucide:info', current: false },
];

/** 右侧快捷项：只用带下拉的三组工具（翻译 / 网盘 / 邮箱），不再放站内锚点文字链 */
const QUICK = TOOLS;

/** 抽屉底部固定区：与顶栏菜单顺序一致（投稿与反馈在前），仅此处交换，不动页脚数据源 */
const TOOLS_FOOTER = [...SITE_LINKS].reverse();
---

<header class="topbar">
  <div class="topbar-pill">
    <nav class="topbar-inner" aria-label="站点导航">
      <button
        type="button"
        data-mobile-nav-open
        aria-label="打开菜单"
        aria-expanded="false"
        class="topbar-icon topbar-icon--mobile menu-btn"
      >
        <span class="menu-bar" aria-hidden="true"></span>
        <span class="menu-bar" aria-hidden="true"></span>
        <span class="menu-bar" aria-hidden="true"></span>
      </button>

      <a href={brandHref(isHome)} class="topbar-brand" aria-label="成医通">
        <img src="/logo.svg" alt="成医通" width="36" height="36" />
        <span class="topbar-brand-text">
          <b>成医通</b>
          <small>nav.cyitong.top</small>
        </span>
      </a>

      <ul class="topbar-menu">
        {
          NAV.map((item) => (
            <li class={item.current ? 'is-current' : ''}>
              <a href={item.href} aria-current={item.current ? 'page' : undefined}>
                <Icon name={item.icon} class="mr-1.5 inline h-4 w-4 align-[-2px]" aria-hidden="true" />
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>

      <span class="topbar-spacer" aria-hidden="true"></span>

      <ul class="topbar-quick">
        {
          QUICK.map((tool) => (
            <li class="relative" data-menu="">
              <button
                type="button"
                data-menu-btn
                aria-haspopup="true"
                aria-expanded="false"
                title={tool.label}
              >
                <Icon name={tool.icon} class="h-4 w-4 shrink-0" aria-hidden="true" />
                {tool.label}
                <Icon
                  name="lucide:chevron-down"
                  class="h-3 w-3 shrink-0 opacity-70"
                  aria-hidden="true"
                />
              </button>
              <div data-menu-panel class="absolute right-0 top-full z-50 mt-1 min-w-36">
                {tool.items.map((sub) => (
                  <a
                    href={sub.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    data-menu-item
                    class="flex items-center gap-2"
                  >
                    <ToolIcon icon={sub.icon} />
                    <span class="truncate">{sub.name}</span>
                  </a>
                ))}
              </div>
            </li>
          ))
        }
      </ul>

      <div class="topbar-icons">
        <button
          type="button"
          data-topbar-history-open
          aria-label="搜索历史"
          title="搜索历史"
          aria-haspopup="dialog"
          aria-expanded="false"
          class="topbar-icon"
        >
          <Icon name="lucide:history" aria-hidden="true" />
        </button>
        <a
          href="https://wiki.cyitong.top"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="wiki"
          title="wiki"
          class="topbar-icon topbar-icon--sm"
        >
          <Icon name="lucide:book-open" aria-hidden="true" />
        </a>
        <a
          href="https://github.com/linlinli000/cyitong-nav"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="GitHub 源码"
          title="GitHub 源码"
          class="topbar-icon topbar-icon--md"
        >
          <svg class="h-5 w-5" aria-hidden="true"><use href="#icon-github" /></svg>
        </a>
        <button
          type="button"
          data-role="tools-open"
          aria-label="打开工具箱"
          aria-haspopup="dialog"
          aria-expanded="false"
          class="topbar-icon topbar-icon--mobile tools-btn"
        >
          <span class="tools-icon tools-icon--grid" aria-hidden="true">
            <Icon name="lucide:layout-grid" />
          </span>
          <span class="tools-icon tools-icon--close" aria-hidden="true">
            <Icon name="lucide:x" />
          </span>
        </button>
      </div>
    </nav>
  </div>
</header>

<!-- 顶栏搜索历史：默认展示引擎搜索，tab 切换站内/社区/文献各自的隔离历史 -->
<div class="topbar-history" data-topbar-history hidden>
  <div class="history-head">
    <span>搜索历史</span>
    <span class="history-actions">
      <button type="button" class="history-clear" data-clear-current>清空本类</button>
      <button type="button" class="history-clear-all" data-clear-all>全部清空</button>
    </span>
  </div>
  <div class="history-body" data-history-body></div>
</div>

<!-- 移动端工具箱抽屉（翻译/网盘/邮箱全量 + 底部站内链接）：
     与左侧侧栏同一套机制——普通定位面板 + 普通遮罩 div，不用的 <dialog> 的 ::backdrop（会走 top layer 盖住另一个抽屉） -->
<nav-tools>
  <div data-tools-backdrop hidden class="fixed inset-0 z-30 bg-black/40"></div>
  <div
    data-role="tools-panel"
    tabindex="-1"
    hidden
    class="m-0 ml-auto h-dvh max-h-dvh w-56 max-w-[84vw] bg-float backdrop-blur-md p-0 text-ink shadow-(--shadow-menu) focus:outline-none"
  >
    <div class="tools-inner flex h-full flex-col">
      <div class="tools-head">
        <span class="drawer-title">工具箱</span>
      </div>
      <div class="tools-scroll scrollbar-hide min-h-0 flex-1 overflow-y-auto px-2 pb-4 pt-1">
        {
          TOOLS.map((tool) => (
            <section class="pt-2 first:pt-0">
              <h3 class="flex items-center gap-x-2 px-2 pb-1.5">
                <Icon name={tool.icon} class="h-[18px] w-[18px] shrink-0 text-brand" aria-hidden="true" />
                <span class="text-body text-muted">{tool.label}</span>
                {/* 数量徽章复用搜索历史弹窗的 .history-tab-count 同款样式 */}
                <span class="history-tab-count ml-auto">{tool.items.length}</span>
              </h3>
              <div class="grid grid-cols-2 gap-1.5">
                {tool.items.map((item) => (
                  <a
                    href={item.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="flex h-[60px] flex-col items-center justify-center gap-1.5 rounded-xl bg-surface px-2 text-body text-ink transition-colors hover:bg-track hover:text-brand"
                  >
                    <img
                      src={item.icon}
                      alt=""
                      aria-hidden="true"
                      loading="lazy"
                      class="h-6 w-6 shrink-0 rounded-md object-contain"
                    />
                    <span class="max-w-full min-w-0 truncate text-center">{item.name}</span>
                  </a>
                ))}
              </div>
            </section>
          ))
        }
      </div>
      <div class="tools-foot shrink-0 pt-2.5">
        {
          TOOLS_FOOTER.map((l) => (
            <a href={l.href} class="sidebar-footer-link">
              <span class="sidebar-footer-icon">
                <Icon name={l.icon} aria-hidden="true" />
              </span>
              <span class="sidebar-footer-label">{l.label}</span>
            </a>
          ))
        }
      </div>
    </div>
  </div>
</nav-tools>

<script>
  import '../web/header-dropdown';
  import '../web/elements/nav-tools';
  import { isSearchScope, type SearchScope } from '../config/search-engines';
  import {
    DEFAULT_HISTORY_TAB,
    clearAll,
    clearScope,
    renderHistoryPanel,
    replaySearch,
  } from '../web/search-history-panel';

  // 顶栏搜索历史：默认引擎搜索，点 tab 切到站内/社区/文献各自的历史
  const histPop = document.querySelector<HTMLElement>('[data-topbar-history]');
  const histBody = histPop?.querySelector<HTMLElement>('[data-history-body]') ?? null;
  const histBtn = document.querySelector<HTMLElement>('[data-topbar-history-open]');

  let histTab: SearchScope = DEFAULT_HISTORY_TAB;

  const renderHist = (): void => {
    if (histBody) renderHistoryPanel(histBody, histTab);
  };

  const openHist = (): void => {
    if (!histPop) return;
    histTab = DEFAULT_HISTORY_TAB;
    renderHist();
    histPop.hidden = false;
    histBtn?.setAttribute('aria-expanded', 'true');
  };

  const closeHist = (): void => {
    if (!histPop) return;
    histPop.hidden = true;
    histBtn?.setAttribute('aria-expanded', 'false');
  };

  histBtn?.addEventListener('click', (e) => {
    e.stopPropagation();
    if (histPop?.hidden) openHist();
    else closeHist();
  });

  histPop?.addEventListener('click', (e) => {
    const t = e.target as Element;

    const tab = t.closest<HTMLElement>('[data-history-tab]');
    if (tab) {
      const scope = tab.dataset.historyTab;
      if (isSearchScope(scope) && scope !== histTab) {
        histTab = scope;
        renderHist();
      }
      return;
    }

    const item = t.closest<HTMLElement>('[data-q]');
    if (item) {
      const scope = item.dataset.scope;
      const q = item.dataset.q;
      if (isSearchScope(scope) && q) {
        replaySearch(scope, q);
        closeHist();
      }
      return;
    }

    if (t.closest('[data-clear-current]')) {
      clearScope(histTab);
      renderHist();
      return;
    }

    if (t.closest('[data-clear-all]')) {
      clearAll();
      renderHist();
    }
  });

  document.addEventListener('click', (e) => {
    if (!histPop || histPop.hidden) return;
    // 面板内切 tab 会重建 innerHTML，target 已脱离文档，用事件路径判断归属
    const path = e.composedPath();
    if (path.includes(histPop)) return;
    if (path.some((n) => n instanceof Element && n.hasAttribute('data-topbar-history-open'))) return;
    closeHist();
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && histPop && !histPop.hidden) closeHist();
  });
</script>
