---
import { Icon } from 'astro-icon/components';

/** 顶部栏图标统一 lucide（astro-icon 构建期内联，勿手抄 path；换图改 iconify 名即可）*/
const MENU_ICON = 'lucide:menu';
const CARET_ICON = 'lucide:chevron-down';

/* 三个快速工具下拉（右侧，月亮按钮左侧）。菜单项 favicon：有道/讯飞/Gmail 无好用的官方源，本地存 public/icons/topbar/*.webp（ffmpeg 无损转，体积减半）；其余直链品牌官网 favicon。 */
const TOOLS = [
  {
    id: 'translate',
    label: '翻译',
    icon: 'lucide:globe',
    items: [
      { name: '百度翻译', url: 'https://fanyi.baidu.com/', icon: 'https://fanyi.baidu.com/favicon.ico' },
      {
        name: '有道翻译',
        url: 'https://fanyi.youdao.com/indexLLM.html#/',
        icon: '/icons/topbar/youdao.webp',
      },
      { name: '搜狗翻译', url: 'https://fanyi.sogou.com/text', icon: 'https://dlweb.sogoucdn.com/translate/favicon.ico' },
      { name: 'DeepL', url: 'https://www.deepl.com/zh/translator', icon: 'https://www.deepl.com/img/favicon/favicon_32.png' },
      {
        name: '讯飞翻译',
        url: 'https://fanyi.xfyun.cn/console/trans/text',
        icon: '/icons/topbar/iflytek.webp',
      },
    ],
  },
  {
    id: 'drive',
    label: '网盘',
    icon: 'lucide:cloud-download',
    items: [
      { name: '百度网盘', url: 'https://pan.baidu.com', icon: 'https://nd-static.bdstatic.com/m-static/v20-main/favicon-main.ico' },
      {
        name: '阿里云盘',
        url: 'https://www.alipan.com',
        icon: 'https://img.alicdn.com/imgextra/i1/O1CN01JDQCi21Dc8EfbRwvF_!!6000000000236-73-tps-64-64.ico',
      },
      {
        name: '夸克网盘',
        url: 'https://pan.quark.cn',
        icon: 'https://image.quark.cn/s/uae/g/3o/broccoli/resource/202404/d94d93e0-03a2-11ef-be4c-79ebae2e18ac.vnd.microsoft.icon',
      },
      { name: '蓝奏云', url: 'https://www.lanzou.com', icon: 'https://www.lanzou.com/favicon.ico' },
      { name: '迅雷网盘', url: 'https://pan.xunlei.com', icon: 'https://pan.xunlei.com/icon.png' },
    ],
  },
  {
    id: 'mail',
    label: '邮箱',
    icon: 'lucide:mail',
    items: [
      {
        name: 'QQ邮箱',
        url: 'https://mail.qq.com',
        icon: 'https://res.wx.qq.com/t/webmail/webmail/res/static/images/base/style/favicon/qqmail_favicon_48h.4e79647.png',
      },
      { name: '163邮箱', url: 'https://mail.163.com', icon: 'https://mail.163.com/favicon.ico' },
      { name: 'Outlook', url: 'https://outlook.live.com', icon: 'https://outlook.live.com/mail/favicon.ico' },
      { name: 'Gmail', url: 'https://mail.google.com', icon: '/icons/topbar/gmail.webp' },
    ],
  },
] as const;
---

<header class="sticky top-0 z-20 border-b border-line bg-card/80 backdrop-blur">
  <div class="relative flex items-center justify-between gap-3 px-4 py-2.5 sm:px-5 lg:px-4">
    <!-- 移动居中品牌（lg 隐藏，桌面侧栏已有）：左右按钮宽不对称 → 绝对居中而非三列 flex -->
    <a
      href="#top"
      aria-label="成医通"
      class="absolute left-1/2 top-1/2 flex -translate-x-1/2 -translate-y-1/2 items-center gap-2 whitespace-nowrap lg:hidden"
    >
      <img src="/logo.svg" alt="" width="32" height="32" class="h-8 w-8 shrink-0" />
      <span class="leading-none">
        <span class="block text-[16px] font-bold text-ink">成医通</span>
        <!-- ≥360px 才显示：logo 在窄屏将副标题与左侧 wiki 隔开不重叠 -->
        <span class="mt-1 hidden text-[10px] text-muted min-[360px]:block">nav.cyitong.top</span>
      </span>
    </a>

    <div class="flex items-center gap-0.5 lg:gap-2">
      <button
        type="button"
        data-mobile-nav-open
        aria-label="打开菜单"
        aria-expanded="false"
        class="grid h-9 w-9 shrink-0 place-items-center rounded-xl text-muted transition-colors hover:bg-surface hover:text-ink lg:hidden"
      >
        <Icon name={MENU_ICON} class="h-6 w-6" aria-hidden="true" />
      </button>

      <!-- 桌面端折叠侧栏（aria 由 nav-sidebar 同步） -->
      <button
        type="button"
        data-sidebar-toggle
        aria-label="收起侧边栏"
        aria-expanded="true"
        class="hidden h-9 w-9 shrink-0 place-items-center rounded-xl text-muted transition-colors hover:bg-surface hover:text-ink lg:grid"
      >
        <Icon name={MENU_ICON} class="h-6 w-6" aria-hidden="true" />
      </button>

      <!-- wiki 入口 -->
      <a
        href="https://wiki.cyitong.top"
        aria-label="wiki"
        title="wiki"
        class="inline-flex h-9 shrink-0 items-center gap-1.5 rounded-xl px-3 text-sm font-medium text-muted transition-colors hover:bg-surface hover:text-ink"
      >
        <Icon name="lucide:book-open" class="h-5 w-5 shrink-0" aria-hidden="true" />
        wiki
      </a>
    </div>

    <div class="flex items-center gap-2">
      <!-- 翻译/网盘/邮箱 快速工具下拉（图标+文字药丸，月亮左侧；移动端拥挤故 lg 起显示） -->
      {TOOLS.map((tool) => (
        <div class="relative hidden lg:block" data-menu>
          <button
            type="button"
            data-menu-btn
            aria-haspopup="true"
            aria-expanded="false"
            title={tool.label}
            class="inline-flex h-9 shrink-0 items-center gap-1.5 rounded-xl px-3 text-sm font-medium text-muted transition-colors hover:bg-surface hover:text-ink"
          >
            <Icon name={tool.icon} class="h-5 w-5 shrink-0" aria-hidden="true" />
            {tool.label}
            <Icon name={CARET_ICON} class="h-3 w-3 shrink-0 opacity-70" aria-hidden="true" />
          </button>
          <div
            data-menu-panel
            class="absolute right-0 top-full z-50 mt-1.5 min-w-44 rounded-xl border border-line bg-card p-1.5 shadow-[0_10px_30px_rgba(0,0,0,0.12)] dark:shadow-[0_10px_30px_rgba(0,0,0,0.45)]"
          >
            <div class="space-y-0.5">
              {tool.items.map((item) => (
                <a
                  href={item.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  data-menu-item
                  class="flex items-center gap-2 rounded-lg px-2 py-1.5 text-sm text-muted transition-colors hover:bg-surface hover:text-ink"
                >
                  <img
                    src={item.icon}
                    alt=""
                    aria-hidden="true"
                    loading="lazy"
                    class="h-6 w-6 shrink-0 rounded-md object-contain"
                  />
                  <span class="truncate">{item.name}</span>
                </a>
              ))}
            </div>
          </div>
        </div>
      ))}

      <nav-theme-toggle />
      <!-- GitHub 源码（最右） -->
      <a
        href="https://github.com/linlinli000/cyitong-nav"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="GitHub 源码"
        title="GitHub 源码"
        class="grid h-9 w-9 shrink-0 place-items-center rounded-xl text-muted transition-colors hover:bg-surface hover:text-ink"
      >
        <Icon name="simple-icons:github" class="h-6 w-6" aria-hidden="true" />
      </a>
    </div>
  </div>
</header>

<!-- 自注册自定义元素：升级 <nav-theme-toggle> 宿主 -->
<script>
  import '../components/web/nav-theme-toggle';
</script>

<!-- 顶部栏下拉交互（data-menu 开关 / 外点关闭 / Esc） -->
<script>
  import './web/header-dropdown';
</script>
