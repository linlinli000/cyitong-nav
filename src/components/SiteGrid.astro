---
import type { CollectionEntry } from 'astro:content';
import CategoryBlock from './CategoryBlock.astro';

interface Props {
  categories: CollectionEntry<'sites'>[];
}

const { categories } = Astro.props;
---

<div class="space-y-6">
  {
    categories.map((cat) => (
      <CategoryBlock category={cat} />
    ))
  }
</div>
