---
import type { CollectionEntry } from 'astro:content';
import { Icon } from 'astro-icon/components';
import { categoryIcon } from '../data/category-icons';

interface Props {
  categories: CollectionEntry<'sites'>[];
}

const { categories } = Astro.props;
---

<aside
  id="sidebar"
  class="fixed inset-y-0 left-0 z-40 flex w-56 -translate-x-full flex-col border-r border-line bg-card transition-transform duration-200 dark:border-line/60 lg:translate-x-0"
>
  <script is:inline>
    (function () {
      try {
        if (localStorage.getItem('nav:rail') === 'collapsed') {
          document.getElementById('sidebar').classList.add('is-collapsed');
        }
      } catch (e) {}
    })();
  </script>
  <div class="sidebar-header flex h-14 items-center px-4">
    <a href="#top" class="sidebar-brand flex min-w-0 flex-1 items-center gap-2.5">
      <img src="/logo.svg" alt="成医通" width="36" height="36" class="h-9 w-9 shrink-0" />
      <span class="sidebar-brand-text">
        <span class="block text-lg font-bold leading-tight text-ink">成医通</span>
        <span class="block text-[11px] text-muted">nav.cyitong.top</span>
      </span>
    </a>
  </div>

  <nav class="scrollbar-hide flex-1 overflow-y-auto px-2 py-4" aria-label="分类导航">
    <div class="space-y-1">
      {
        categories.map((cat) => {
          const linkCount = cat.data.subs.reduce((n, s) => n + s.links.length, 0);
          return (
            <div class="sidebar-group" data-cat={cat.data.id}>
              <button
                type="button"
                class="sidebar-cat-toggle sidebar-cat-link flex w-full items-center gap-x-2 rounded-lg py-2 font-medium text-muted transition-colors hover:bg-surface hover:text-ink"
                aria-expanded="true"
                title={cat.data.name}
              >
                <span class="sidebar-cat-icon shrink-0 text-brand">
                  <Icon name={categoryIcon(cat.data.icon)} class="h-5 w-5" />
                </span>
                <span class="sidebar-cat-meta">
                  <span class="sidebar-cat-name truncate text-[15px]">{cat.data.name}</span>
                  <span class="sidebar-cat-count shrink-0 text-xs text-muted">{linkCount}</span>
                  <Icon
                    name="lucide:chevron-right"
                    class="sidebar-chevron h-4 w-4 shrink-0 text-muted"
                  />
                </span>
              </button>
              <div class="sidebar-sub">
                <div class="space-y-0.5 pt-0.5">
                  {
                    cat.data.subs.map((sub) => (
                      <a
                        href={`#${cat.data.id}`}
                        data-sub-id={sub.id}
                        data-cat={cat.data.id}
                        class="sub-link block rounded-lg px-3 py-1.5 text-[13px] text-muted transition-colors hover:bg-surface hover:text-ink"
                      >
                        {sub.name}
                      </a>
                    ))
                  }
                </div>
              </div>
            </div>
          );
        })
      }
    </div>
  </nav>

  <div class="sidebar-footer px-2 py-4">
    <div class="space-y-1">
      <a
        href="https://github.com/linlinli000/cyitong-nav/issues"
        target="_blank"
        rel="noopener noreferrer"
        class="sidebar-footer-link flex w-full items-center gap-x-2 rounded-lg py-2 font-medium text-muted transition-colors hover:bg-surface hover:text-ink"
      >
        <span class="sidebar-footer-icon shrink-0 text-brand">
          <Icon name="heroicons:chat-bubble-left-right-solid" class="h-5 w-5" aria-hidden="true" />
        </span>
        <span class="sidebar-footer-label min-w-0 flex-1 truncate text-[15px]">反馈问题</span>
      </a>
      <a
        href="mailto:s1077529874@163.com"
        class="sidebar-footer-link flex w-full items-center gap-x-2 rounded-lg py-2 font-medium text-muted transition-colors hover:bg-surface hover:text-ink"
      >
        <span class="sidebar-footer-icon shrink-0 text-brand">
          <Icon name="heroicons:envelope-solid" class="h-5 w-5" aria-hidden="true" />
        </span>
        <span class="sidebar-footer-label min-w-0 flex-1 truncate text-[15px]">投稿邮箱</span>
      </a>
      <a
        href="https://github.com/linlinli000/cyitong-nav/pulls"
        target="_blank"
        rel="noopener noreferrer"
        class="sidebar-footer-link flex w-full items-center gap-x-2 rounded-lg py-2 font-medium text-muted transition-colors hover:bg-surface hover:text-ink"
      >
        <span class="sidebar-footer-icon shrink-0 text-brand">
          <Icon name="heroicons:plus-circle-solid" class="h-5 w-5" aria-hidden="true" />
        </span>
        <span class="sidebar-footer-label min-w-0 flex-1 truncate text-[15px]">添加链接</span>
      </a>
    </div>
  </div>
</aside>

<div data-sidebar-backdrop class="fixed inset-0 z-30 hidden bg-black/50 lg:hidden"></div>
