---
import type { CollectionEntry } from 'astro:content';
import { Icon } from 'astro-icon/components';
import { categoryIcon } from '../config/category-icons';
import { categoryLinkCount } from '../lib/site-data';
import { SITE_LINKS } from '../config/site-links';

interface Props {
  categories: CollectionEntry<'sites'>[];
  isHome: boolean;
}

const { categories, isHome } = Astro.props;

// 内容页无分类区块，锚点须带回首页路径
const catAnchor = (id: string): string => (isHome ? `#${id}` : `/#${id}`);

const FOOTER_LINKS = [...SITE_LINKS].reverse();
---

<aside id="sidebar" class="-translate-x-full">
  <div class="sidebar-header">
    <span class="drawer-title">分类</span>
  </div>

  <nav aria-label="分类导航">
    <div>
      {
        categories.map((cat) => {
          const linkCount = categoryLinkCount(cat);
          return (
            <div class="sidebar-group" data-cat={cat.data.id}>
              <button
                type="button"
                class="sidebar-cat-toggle sidebar-cat-link"
                aria-expanded="false"
                title={cat.data.name}
              >
                <span class="sidebar-cat-icon">
                  <Icon name={categoryIcon(cat.data.icon)} aria-hidden="true" />
                </span>
                <span class="sidebar-cat-meta">
                  <span class="sidebar-cat-name">{cat.data.name}</span>
                  <span class="sidebar-cat-count">{linkCount}</span>
                  <Icon name="lucide:chevron-right" class="sidebar-chevron" aria-hidden="true" />
                </span>
              </button>
              <div class="sidebar-sub">
                <div>
                  {cat.data.subs.map((sub) => (
                    <a
                      href={catAnchor(cat.data.id)}
                      data-sub-id={sub.id}
                      data-cat={cat.data.id}
                      class="sub-link"
                    >
                      {sub.name}
                    </a>
                  ))}
                </div>
              </div>
            </div>
          );
        })
      }
    </div>
  </nav>

  <div class="sidebar-footer">
    <!-- 桌面端：折叠成图标条（移动端隐藏） -->
    <div class="sidebar-footer-rail">
      <button type="button" data-sidebar-toggle class="sidebar-footer-link" aria-label="收起侧边栏">
        <span class="sidebar-footer-icon">
          <Icon name="lucide:panel-left-close" class="footer-icon footer-icon--close" aria-hidden="true" />
          <Icon name="lucide:panel-left-open" class="footer-icon footer-icon--open" aria-hidden="true" />
        </span>
        <span class="sidebar-footer-label">收起</span>
      </button>
    </div>
    <!-- 移动端：站内链接（投稿/关于），顺序与右侧工具箱抽屉一致 -->
    <div class="sidebar-footer-links">
      {FOOTER_LINKS.map((l) => (
        <a href={l.href} class="sidebar-footer-link">
          <span class="sidebar-footer-icon">
            <Icon name={l.icon} aria-hidden="true" />
          </span>
          <span class="sidebar-footer-label">{l.label}</span>
        </a>
      ))}
    </div>
  </div>
</aside>

<div data-sidebar-backdrop hidden class="fixed inset-0 z-(--z-overlay) bg-black/40 lg:hidden"></div>
