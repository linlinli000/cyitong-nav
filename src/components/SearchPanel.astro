---
import { Icon } from 'astro-icon/components';
import { placeholderFor } from '../config/search-engines';
import type { SiteRecord } from '../web/search-utils';

interface Props {
  searchIndex: SiteRecord[];
}

const { searchIndex } = Astro.props;

const defaultPlaceholder = placeholderFor('search', 0);
---

<section class="py-10 sm:py-18">
  <nav-search>
    <div class="relative mx-auto w-full max-w-[50rem]">
      <div
        class="search-field flex items-center gap-1.5 rounded-2xl bg-field py-1.5 pl-1.5 pr-1 transition-all sm:gap-2 sm:pl-2 sm:pr-1.5"
      >
        <!-- 上下文芯片：范围+引擎+类型 合一 -->
        <div class="relative shrink-0" data-role="ctx">
          <button
            type="button"
            data-role="ctx-btn"
            aria-haspopup="listbox"
            aria-expanded="false"
            class="ctx-btn"
          >
            <span data-role="ctx-label"></span>
            <Icon name="lucide:chevron-down" class="ctx-chevron h-3 w-3 shrink-0 opacity-80" aria-hidden="true" />
          </button>
          <div
            data-role="ctx-menu"
            role="listbox"
            aria-label="搜索范围与引擎"
            hidden
            class="absolute left-0 top-full z-30 mt-1.5 w-[min(20rem,calc(100vw_-_2rem))] max-h-[min(60vh,26rem)] overflow-y-auto rounded-xl bg-card p-2 shadow-[var(--shadow-menu)]"
          ></div>
        </div>

        <span class="h-5 w-px bg-line" aria-hidden="true"></span>

        <input
          type="text"
          data-role="input"
          autocomplete="off"
          spellcheck="false"
          value=""
          placeholder={defaultPlaceholder}
          aria-label="搜索"
          role="combobox"
          aria-expanded="false"
          aria-controls="nav-search-listbox"
          aria-autocomplete="list"
          class="min-w-0 flex-1 bg-transparent text-body text-ink outline-none placeholder:text-muted sm:text-base"
        />
        <button
          type="button"
          data-role="submit"
          aria-label="搜索"
          class="btn-brand grid h-9 w-9 shrink-0 place-items-center rounded-xl sm:h-10 sm:w-10"
        >
          <Icon name="lucide:search" class="h-4 w-4 sm:h-5 sm:w-5" aria-hidden="true" />
        </button>
      </div>

      <div
        data-role="dropdown"
        id="nav-search-listbox"
        role="listbox"
        aria-label="搜索建议"
        hidden
        class="search-dropdown absolute inset-x-0 top-full z-30 mt-1.5 max-h-96 overflow-y-auto rounded-xl bg-field shadow-[var(--shadow-dropdown)]"
      ></div>
    </div>
  </nav-search>
</section>

<script>
  import '../web/elements/nav-search';
</script>
