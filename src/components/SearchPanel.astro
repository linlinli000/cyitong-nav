---
import { Icon } from 'astro-icon/components';
import { placeholderFor } from '../config/search-engines';
import type { SiteRecord } from '../web/search-utils';
import { quickTileInner } from '../web/quick-tile';

interface Props {
  searchIndex: SiteRecord[];
}

const { searchIndex } = Astro.props;

// 常用磁贴默认集（nav-hero 与最近使用合并去重）；引用缺失构建期 fail-fast
const QUICK_PICKS: Array<[string, string]> = [
  ['campus', 'jwxt'],
  ['campus', 'lib'],
  ['campus', 'ykt'],
  ['campus', 'xgw'],
  ['study', 'chaoxing'],
  ['academic', 'cnki'],
  ['academic', 'pubmed'],
  ['scitools', 'deepl'],
];
const quickLinks = QUICK_PICKS.map(([catId, id]) => {
  const hit = searchIndex.find((r) => r.catId === catId && r.id === id);
  if (!hit) throw new Error(`[SearchPanel] QUICK_PICKS 引用的链接不存在：${catId}/${id}`);
  return hit;
});

const defaultPlaceholder = placeholderFor('search', 0);
---

<section class="py-10 sm:py-18">
  <!-- 首屏 hero：时钟/日期/问候（客户端对时） -->
  <div class="mb-6 text-center sm:mb-8">
    <div class="flex h-10 items-baseline justify-center gap-2.5 sm:h-12">
      <time
        id="hero-clock"
        class="text-4xl leading-none font-extralight tracking-tight text-ink tabular-nums sm:text-5xl"></time>
      <span id="hero-date" class="text-dense text-muted"></span>
    </div>
    <p id="hero-greeting" class="mt-2 text-body text-muted">今天想查什么？</p>
  </div>

  <nav-search>
    <div class="relative mx-auto w-full max-w-[50rem]">
      <div
        class="search-field flex items-center gap-1.5 rounded-2xl bg-field py-1.5 pl-1.5 pr-1 transition-all sm:gap-2 sm:pl-2 sm:pr-1.5"
      >
        <!-- 上下文芯片：范围+引擎+类型 合一 -->
        <div class="relative shrink-0" data-role="ctx">
          <button
            type="button"
            data-role="ctx-btn"
            aria-haspopup="listbox"
            aria-expanded="false"
            class="ctx-btn"
          >
            <span data-role="ctx-label"></span>
            <Icon name="lucide:chevron-down" class="ctx-chevron h-3 w-3 shrink-0 opacity-80" aria-hidden="true" />
          </button>
          <div
            data-role="ctx-menu"
            role="listbox"
            aria-label="搜索范围与引擎"
            hidden
            class="absolute left-0 top-full z-30 mt-1.5 w-[min(20rem,calc(100vw_-_2rem))] max-h-[min(60vh,26rem)] overflow-y-auto rounded-xl bg-card p-2 shadow-[var(--shadow-menu)]"
          ></div>
        </div>

        <span class="h-5 w-px bg-line" aria-hidden="true"></span>

        <input
          type="text"
          data-role="input"
          autocomplete="off"
          spellcheck="false"
          value=""
          placeholder={defaultPlaceholder}
          aria-label="搜索"
          role="combobox"
          aria-expanded="false"
          aria-controls="nav-search-listbox"
          aria-autocomplete="list"
          class="min-w-0 flex-1 bg-transparent text-body text-ink outline-none placeholder:text-muted sm:text-base"
        />
        <button
          type="button"
          data-role="submit"
          aria-label="搜索"
          class="btn-brand grid h-9 w-9 shrink-0 place-items-center rounded-xl sm:h-10 sm:w-10"
        >
          <Icon name="lucide:search" class="h-4 w-4 sm:h-5 sm:w-5" aria-hidden="true" />
        </button>
      </div>

      <div
        data-role="dropdown"
        id="nav-search-listbox"
        role="listbox"
        aria-label="搜索建议"
        hidden
        class="search-dropdown absolute inset-x-0 top-full z-30 mt-1.5 max-h-96 overflow-y-auto rounded-xl bg-field shadow-[var(--shadow-dropdown)]"
      ></div>
    </div>
  </nav-search>

  <!-- 常用磁贴行：nav-hero 与最近使用合并去重后渲染 -->
  <div
    id="quick-bar"
    data-fade-x
    hidden
    class="mt-6 flex min-h-[4.25rem] items-center overflow-x-auto scrollbar-hide"
  >
    <div id="quick-tiles" class="mx-auto flex w-max shrink-0 items-stretch gap-2 px-1 sm:gap-4">
      {
        quickLinks.map((l) => (
          <a
            href={l.url}
            target="_blank"
            rel="noopener noreferrer"
            data-quick-default
            data-title={l.title}
            data-icon={l.icon}
            title={l.title}
            class="quick-tile"
          >
            <Fragment set:html={quickTileInner(l.title, l.icon)} />
          </a>
        ))
      }
    </div>
  </div>
</section>

<script>
  import '../web/elements/nav-search';
  import { initNavHero } from '../web/nav-hero';

  initNavHero();
</script>
