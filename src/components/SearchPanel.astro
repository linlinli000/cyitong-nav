---
import { Icon } from 'astro-icon/components';
import { ENGINES, SCOPE_TABS, placeholderFor, type SearchScope } from '../data/search-engines';

interface Props {
  total: number;
}

const { total } = Astro.props;

const DEFAULT_SCOPE: SearchScope = 'search';
const DEFAULT_ENGINE = 0;
const EXTERNAL_SCOPES = ['search', 'community', 'literature'] as const;

function isSite(scope: SearchScope): boolean {
  return scope === 'site';
}

const defaultPlaceholder = placeholderFor(DEFAULT_SCOPE, DEFAULT_ENGINE);
---

<section class="py-8 sm:py-10">
  <nav-search>
    <!-- scope 胶囊 -->
    <div data-fade-x class="scrollbar-hide mb-2 flex overflow-x-auto sm:mb-3">
      <div
        class="mx-auto flex shrink-0 items-center gap-1 rounded-full bg-card p-1 sm:gap-1.5"
      >
        {
          SCOPE_TABS.map((tab) => (
            <button
              type="button"
              data-scope={tab.id}
              aria-pressed={tab.id === DEFAULT_SCOPE}
              class:list={[
                'scope-pill inline-flex shrink-0 items-center whitespace-nowrap rounded-full px-4 py-1.5 text-dense transition-all sm:px-5 sm:py-2 sm:text-sm',
                tab.id === DEFAULT_SCOPE && 'active',
              ]}
            >
              {tab.label}
            </button>
          ))
        }
      </div>
    </div>

    <div class="relative mx-auto w-full max-w-[50rem]">
      <div
        class="search-field flex items-center gap-1.5 rounded-2xl bg-field py-1.5 pl-3.5 pr-1 transition-all sm:gap-2 sm:pl-5 sm:pr-1.5"
      >
        <input
          type="text"
          data-role="input"
          autocomplete="off"
          spellcheck="false"
          value=""
          placeholder={defaultPlaceholder}
          aria-label="搜索"
          class="min-w-0 flex-1 bg-transparent text-body text-ink outline-none placeholder:text-muted sm:text-base"
        />
        <button
          type="button"
          data-role="submit"
          aria-label="搜索"
          class="btn-brand grid h-9 w-9 shrink-0 place-items-center rounded-xl sm:h-10 sm:w-10"
        >
          <Icon name="lucide:search" class="h-4 w-4 sm:h-5 sm:w-5" aria-hidden="true" />
        </button>
      </div>

      <div
        data-role="dropdown"
        hidden
        class="search-dropdown absolute inset-x-0 top-full z-30 mt-1.5 max-h-96 overflow-y-auto rounded-xl bg-field shadow-[var(--shadow-dropdown)]"
      ></div>
    </div>

    <!-- 站内计数行 -->
    <div
      data-role="site-footer"
      class="mt-2 flex min-h-[2.75rem] items-center justify-center sm:mt-3"
      hidden={!isSite(DEFAULT_SCOPE)}
    >
      <span class="inline-flex items-center gap-1 rounded-full bg-card px-3.5 py-1 text-dense text-muted sm:px-4"
        >本网站已收录<span class="font-semibold text-brand">{total}</span>个常用链接</span
      >
    </div>

    <!-- 各外部 scope 引擎 chips 条 -->
    {
      EXTERNAL_SCOPES.map((sc) => {
        const active = sc === DEFAULT_SCOPE;
        return (
          <div
            data-role="engine-bar"
            data-engine-scope={sc}
            hidden={!active}
            data-fade-x
            class="mt-2 flex min-h-[2.75rem] items-center overflow-x-auto scrollbar-hide sm:mt-3"
          >
            <div
              class="mx-auto flex shrink-0 items-center gap-1 rounded-full bg-card p-1"
            >
              {
                ENGINES[sc].map((e, i) => (
                  <button
                    type="button"
                    data-engine={i}
                    data-engine-scope={sc}
                    class:list={[
                      'engine-chip inline-flex shrink-0 items-center gap-1.5 whitespace-nowrap rounded-full px-2.5 py-1 text-dense transition-all sm:px-3',
                      active && i === DEFAULT_ENGINE && 'active',
                    ]}
                  >
                    <svg class="h-3.5 w-3.5" aria-hidden="true"><use href={`#icon-${e.icon}`} /></svg>
                    {e.name}
                  </button>
                ))
              }
            </div>
          </div>
        );
      })
    }
  </nav-search>
</section>

<script>
  import '../web/elements/nav-search';
</script>
