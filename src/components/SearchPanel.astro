---
import { Icon } from 'astro-icon/components';
import { placeholderFor } from '../config/search-engines';
import type { SiteRecord } from '../web/shared/search-utils';
import { quickAddHtml, quickTileHtml } from '../web/quick-bar/quick-tile';

interface Props {
  searchIndex: SiteRecord[];
}

const { searchIndex } = Astro.props;

// 常用磁贴默认集（quick-bar 与最近使用合并去重）；引用缺失构建期 fail-fast
const QUICK_PICKS: Array<[string, string]> = [
  ['campus', 'jwxt'],
  ['campus', 'xgw'],
  ['study', 'chaoxing'],
  ['study', 'zhihuishu'],
  ['campus', 'lib'],
  ['academic', 'pubmed'],
  ['academic', 'cnki'],
  ['campus', 'shiguang'],
  ['study', 'icourse'],
];
const quickLinks = QUICK_PICKS.map(([catId, id]) => {
  const hit = searchIndex.find((r) => r.catId === catId && r.id === id);
  if (!hit) throw new Error(`[SearchPanel] QUICK_PICKS 引用的链接不存在：${catId}/${id}`);
  return hit;
});

const defaultPlaceholder = placeholderFor('search', 0);
---

<section class="hero">
  <!-- 首屏 hero：SSR 先出等宽占位，保证 LCP 候选在第一帧就有内容；真实时间由 nav-hero 每秒校准 -->
  <div class="hero-lead">
    <div class="hero-lead-row">
      <time id="hero-clock" class="tabular-nums">--:--</time>
      <span id="hero-date">--月--日 周-</span>
    </div>
    <p id="hero-greeting">今天想查什么？</p>
  </div>

  <nav-search class="hero-search">
    <div class="relative w-full">
      <div class="search-field flex items-center">
        <!-- 上下文芯片：范围+引擎+类型 合一 -->
        <div class="relative shrink-0" data-role="ctx">
          <button
            type="button"
            data-role="ctx-btn"
            aria-haspopup="listbox"
            aria-expanded="false"
            class="ctx-btn"
          >
            <span data-role="ctx-label"></span>
            <Icon name="lucide:chevron-down" class="ctx-chevron h-3 w-3 shrink-0 opacity-80" aria-hidden="true" />
          </button>
          <div
            data-role="ctx-menu"
            role="listbox"
            aria-label="搜索范围与引擎"
            hidden
            class="absolute left-0 top-full z-(--z-overlay) mt-1.5 w-[min(20rem,calc(100vw_-_2rem))] max-h-[min(60vh,26rem)] overflow-y-auto rounded-(--r-lg) bg-float p-2 shadow-(--shadow-menu)"
          ></div>
        </div>

        <span class="h-5 w-px bg-line" aria-hidden="true"></span>

        <input
          type="text"
          data-role="input"
          autocomplete="off"
          spellcheck="false"
          value=""
          placeholder={defaultPlaceholder}
          aria-label="搜索"
          role="combobox"
          aria-expanded="false"
          aria-controls="nav-search-listbox"
          aria-autocomplete="list"
          class="min-w-0 flex-1 bg-transparent outline-none"
        />
        <button type="button" data-role="submit" aria-label="搜索" class="btn-brand grid shrink-0 place-items-center">
          <Icon name="lucide:search" aria-hidden="true" />
        </button>
      </div>

      <div
        data-role="dropdown"
        id="nav-search-listbox"
        role="listbox"
        aria-label="搜索建议"
        hidden
        class="search-dropdown absolute inset-x-0 top-full z-(--z-overlay) mt-1.5 max-h-96 overflow-y-auto rounded-(--r-lg) bg-float shadow-(--shadow-menu)"
      ></div>
    </div>
  </nav-search>

  <div class="hero-spacer" aria-hidden="true"></div>

  <!-- 胶囊快捷条：SSG 默认集 + 常驻添加格；客户端由 quick-bar 三层合并重建 -->
  <div class="hero-quick">
    <div id="quick-bar" data-fade-x>
      <div id="quick-tiles">
        {quickLinks.map((l) => <Fragment set:html={quickTileHtml({ url: l.url, title: l.title, icon: l.icon }, { isDefault: true })} />)}
        <Fragment set:html={quickAddHtml()} />
      </div>
    </div>
  </div>
</section>

<nav-quick-add></nav-quick-add>

<script>
  import '../web/elements/nav-search';
  import '../web/elements/nav-quick-add';
  import { initNavHero } from '../web/nav-hero';
  import { initQuickBar } from '../web/quick-bar/quick-bar';

  initNavHero();
  initQuickBar();

  // 「添加」格点击回弹：委托到 document，客户端重建磁贴后依然有效
  document.addEventListener('click', (e) => {
    const btn = (e.target as Element).closest<HTMLElement>('#quick-tiles > .add-tile');
    if (!btn) return;
    btn.classList.remove('is-pop');
    void btn.offsetWidth;
    btn.classList.add('is-pop');
  });

  document.addEventListener('animationend', (e) => {
    if ((e as AnimationEvent).animationName !== 'add-tile-pop') return;
    const btn = (e.target as Element).closest<HTMLElement>('#quick-tiles > .add-tile');
    btn?.classList.remove('is-pop');
  });
</script>
