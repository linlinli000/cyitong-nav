# 静态资源缓存
/*
  Cache-Control: public, max-age=60, stale-while-revalidate=60

/logo.svg
  ! Cache-Control
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

/favicon.ico
  ! Cache-Control
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

/icons/*
  ! Cache-Control
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

/fonts/*
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable

/_astro/*
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable
